# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///retail_crm.db
# For Postgres: postgresql+psycopg2://crm:crm@localhost:5432/retail_crm

# Shop identity (shown on invoices / PDFs)
SHOP_NAME=Rabya Collection
SHOP_ADDRESS=Bengaluru, Karnataka, India
SHOP_GSTIN=29AAAAA0000A1Z5
SHOP_PHONE=+919876543210
SHOP_EMAIL=orders@rabyacollection.example
SHOP_STATE_CODE=29
OWNER_EMAIL=stedmg283@gmail.com
LOGO_PATH=app/static/img/logo_placeholder.png

# Payroll
DEFAULT_SHIFT_HOURS=9
OT_MULTIPLIER=1.5

# GST defaults (apparel often 5% or 12%)
DEFAULT_GST_RATE=5
DEFAULT_HSN=6211

# Invoice numbering: PREFIX/FY/SEQ  e.g. RC/2026-27/0001
INVOICE_PREFIX=RC

# WhatsApp Cloud API — leave blank to force DRY_RUN (no real sends)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_TEMPLATE_NAME=invoice_document
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_WEBHOOK_VERIFY_TOKEN=rabya-verify-change-me

# Dedup / send behaviour
# Same-day merge: append lines to existing invoice for that phone today.
# Send happens on Finalize (+ optional Send WhatsApp), or `flask send-pending`.
SEND_ON_CREATE=false
PENDING_SEND_DEBOUNCE_MINUTES=30

# SMTP for BCC ledger copy of every invoice PDF to OWNER_EMAIL
# Gmail: enable 2-Step Verification, then create a 16-char App Password at
# https://myaccount.google.com/apppasswords and paste it into SMTP_PASSWORD.
# Leave SMTP_PASSWORD blank to skip BCC (app will not crash; it logs/skips).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=stedmg283@gmail.com
SMTP_PASSWORD=
SMTP_FROM="Rabya Collection <stedmg283@gmail.com>"
SMTP_USE_TLS=true

# Timezone for "today" (IST)
TZ=Asia/Kolkata
